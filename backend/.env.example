# ===========================
# App Config Config
# ===========================
BASE_URL=http://localhost:8080/api/v1


# ===========================
# PostgreSQL Config
# ===========================
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_HOST=<localhost | docker_db_name>
POSTGRES_PORT=<port_number>
POSTGRES_DB=<db_name>